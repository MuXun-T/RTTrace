{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTDP4CaptureAssemblyInput",
  "type": "object",
  "required": ["schema_version", "assembly_input_id", "capture_id", "session_id", "test_only", "config_export_ref", "config_export_digest", "p2_snapshot_ref", "p2_snapshot_digest", "raw_trace_id", "raw_trace_hash", "counter_report_ref", "counter_report_digest", "decoder_report_ref", "decoder_report_digest", "alignment_report_ref", "alignment_report_digest", "buffer_capacity_unit", "buffer_high_watermark_unit", "record_digest"],
  "properties": {
    "schema_version": {"const": "rtd-phase4-prehardware-v1.0"},
    "capture_id": {"type": "string", "pattern": "^capture:[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "test_only": {"type": "boolean"},
    "buffer_capacity_unit": {"const": "records"},
    "buffer_high_watermark_unit": {"const": "records"},
    "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
