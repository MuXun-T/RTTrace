{
  "dict_ver": 1,
  "domain_defs": {
    "task": "task lifecycle and scheduler events",
    "sync": "synchronization and resource events",
    "irq": "interrupt events",
    "integrity": "trace integrity events",
    "align": "cross-core alignment events"
  },
  "enum_defs": {
    "ready_reason": {
      "1": "create",
      "2": "resume",
      "3": "preempt_return",
      "4": "irq_return"
    },
    "block_reason": {
      "1": "delay",
      "2": "suspend",
      "3": "mutex_wait",
      "4": "sem_wait",
      "5": "queue_wait",
      "6": "flag_wait",
      "7": "task_sem_wait",
      "8": "task_msgq_wait"
    },
    "wake_source": {
      "1": "resource_release",
      "2": "timer",
      "3": "task_resume",
      "4": "irq"
    },
    "switch_reason": {
      "1": "dispatch",
      "2": "preempt",
      "3": "block",
      "4": "wakeup",
      "5": "irq_return",
      "6": "exit"
    },
    "integrity_reason": {
      "1": "seq_gap",
      "2": "buffer_overflow",
      "3": "io_backpressure",
      "4": "media_corruption"
    },
    "obj_type": {
      "1": "mutex",
      "2": "sem",
      "3": "queue",
      "4": "flag",
      "5": "task_sem",
      "6": "task_msgq"
    }
  },
