{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisContext",
  "type": "object",
  "required": [
    "time_window",
    "filter",
    "selection",
    "zoom_level",
    "focused_view",
    "evidence_anchor",
    "playback_cursor",
    "compare_scope",
    "dataset_role"
  ],
  "properties": {
    "time_window": {"type": "array", "items": {"type": "number"}},
    "filter": {"type": "object"},
    "selection": {"type": "object"},
    "zoom_level": {"type": "number"},
    "focused_view": {"type": ["string", "null"]},
    "evidence_anchor": {"type": ["object", "null"]},
    "playback_cursor": {"type": ["object", "null"]},
    "compare_scope": {"type": ["object", "null"]},
    "dataset_role": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}

