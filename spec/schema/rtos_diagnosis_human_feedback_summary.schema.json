    "source_feedback_set_hash": {"type": "string", "minLength": 64, "maxLength": 64}, "source_report_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "source_review_hashes": {"type": "array", "items": {"type": "object", "required": ["review_id", "variant_id", "canonical_hash"], "properties": {"review_id": {"type": "string", "minLength": 1}, "variant_id": {"type": "string", "enum": ["advisor_disabled", "deterministic_template", "retrieval_grounded_review", "mock_llm_explanation"]}, "canonical_hash": {"type": "string", "minLength": 64, "maxLength": 64}}, "additionalProperties": false}},
    "pipeline_validation_only": {"type": "boolean"}, "contains_real_participant_data": {"type": "boolean"},
    "consent_summary": {"type": "object", "required": ["missing_consent_count", "denied_consent_count", "accepted_consent_count", "consent_violation_count"], "properties": {"missing_consent_count": {"type": "integer", "minimum": 0}, "denied_consent_count": {"type": "integer", "minimum": 0}, "accepted_consent_count": {"type": "integer", "minimum": 0}, "consent_violation_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "privacy_summary": {"type": "object", "required": ["direct_identifier_count", "free_text_count", "demographic_field_count", "secret_leak_count", "absolute_path_leak_count", "privacy_rejection_count"], "properties": {"direct_identifier_count": {"type": "integer", "minimum": 0}, "free_text_count": {"type": "integer", "minimum": 0}, "demographic_field_count": {"type": "integer", "minimum": 0}, "secret_leak_count": {"type": "integer", "minimum": 0}, "absolute_path_leak_count": {"type": "integer", "minimum": 0}, "privacy_rejection_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "record_counts": {"type": "object", "required": ["records_total", "records_accepted", "records_rejected", "synthetic_records_count", "consented_manual_records_count", "real_participant_records_count"], "properties": {"records_total": {"type": "integer", "minimum": 0}, "records_accepted": {"type": "integer", "minimum": 0}, "records_rejected": {"type": "integer", "minimum": 0}, "synthetic_records_count": {"type": "integer", "minimum": 0}, "consented_manual_records_count": {"type": "integer", "minimum": 0}, "real_participant_records_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "variant_metrics": {"type": "array", "items": {"type": "object", "required": ["variant_id", "accepted_record_count", "rating_metrics"], "properties": {"variant_id": {"type": "string", "enum": ["advisor_disabled", "deterministic_template", "retrieval_grounded_review", "mock_llm_explanation"]}, "accepted_record_count": {"type": "integer", "minimum": 0}, "rating_metrics": {"type": "object", "additionalProperties": {"type": "object", "required": ["count", "mean", "minimum", "maximum"], "properties": {"count": {"type": "integer", "minimum": 0}, "mean": {"type": ["number", "null"]}, "minimum": {"type": ["integer", "null"]}, "maximum": {"type": ["integer", "null"]}}, "additionalProperties": false}}}, "additionalProperties": false}},
    "rating_metrics": {"type": "object", "additionalProperties": {"type": "object", "required": ["count", "mean", "minimum", "maximum"], "properties": {"count": {"type": "integer", "minimum": 0}, "mean": {"type": ["number", "null"]}, "minimum": {"type": ["integer", "null"]}, "maximum": {"type": ["integer", "null"]}}, "additionalProperties": false}},
    "structured_flag_metrics": {"type": "object", "required": ["claim_boundary_understood", "unsupported_statement_observed_count", "explanation_too_verbose_count", "explanation_too_brief_count", "limitation_unclear_count", "citation_unclear_count"], "properties": {"claim_boundary_understood": {"type": "object", "required": ["yes", "no", "unsure"], "properties": {"yes": {"type": "integer", "minimum": 0}, "no": {"type": "integer", "minimum": 0}, "unsure": {"type": "integer", "minimum": 0}}, "additionalProperties": false}, "unsupported_statement_observed_count": {"type": "integer", "minimum": 0}, "explanation_too_verbose_count": {"type": "integer", "minimum": 0}, "explanation_too_brief_count": {"type": "integer", "minimum": 0}, "limitation_unclear_count": {"type": "integer", "minimum": 0}, "citation_unclear_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "integrity_metrics": {"type": "object", "required": ["source_hash_mismatch_count", "source_mutation_count", "root_cause_mutation_count", "replay_status_mutation_count", "claim_class_mutation_count", "proof_drift_count", "invalid_record_count", "duplicate_response_id_count"], "properties": {"source_hash_mismatch_count": {"type": "integer", "minimum": 0}, "source_mutation_count": {"type": "integer", "minimum": 0}, "root_cause_mutation_count": {"type": "integer", "minimum": 0}, "replay_status_mutation_count": {"type": "integer", "minimum": 0}, "claim_class_mutation_count": {"type": "integer", "minimum": 0}, "proof_drift_count": {"type": "integer", "minimum": 0}, "invalid_record_count": {"type": "integer", "minimum": 0}, "duplicate_response_id_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "claim_boundary": {"type": "object", "required": ["human_effect_claimable", "usability_improvement_claimable", "diagnosis_correctness_claimable", "root_cause_correctness_claimable", "replay_correctness_claimable", "proof_correctness_claimable", "descriptive_pipeline_only"], "properties": {"human_effect_claimable": {"type": "boolean"}, "usability_improvement_claimable": {"type": "boolean"}, "diagnosis_correctness_claimable": {"type": "boolean"}, "root_cause_correctness_claimable": {"type": "boolean"}, "replay_correctness_claimable": {"type": "boolean"}, "proof_correctness_claimable": {"type": "boolean"}, "descriptive_pipeline_only": {"type": "boolean"}}, "additionalProperties": false},
    "limitations": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "array", "items": {"type": "string"}}
  }, "additionalProperties": false
}
