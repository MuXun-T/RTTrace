{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTDCaptureIntegrityRecord",
  "type": "object",
  "required": ["schema_version", "cir_record_id", "capture_id", "session_id", "capability_manifest_id", "capability_manifest_digest", "raw_trace_id", "raw_trace_hash", "firmware_hash", "ELF_hash", "config_hash", "source_commit", "immutable_input_refs", "sequence_continuity", "sequence_gaps", "loss", "overflow", "overflow_count", "buffer_high_watermark", "truncation", "corruption", "alignment_degradation", "mapping_mismatch", "observer_loss", "affected_intervals", "affected_channels", "affected_entities", "natural_overflow", "integrity_status", "reason_codes", "prior_cir_ref", "record_digest"],
  "properties": {
    "schema_version": {"type": "string"}, "cir_record_id": {"type": "string"}, "capture_id": {"type": "string", "pattern": "^capture:[A-Za-z0-9][A-Za-z0-9._-]*$"}, "session_id": {"type": "string"}, "capability_manifest_id": {"type": "string"}, "capability_manifest_digest": {"type": "string"}, "raw_trace_id": {"type": "string"}, "raw_trace_hash": {"type": ["string", "null"]}, "firmware_hash": {"type": "string"}, "ELF_hash": {"type": "string"}, "config_hash": {"type": "string"}, "source_commit": {"type": "string"}, "immutable_input_refs": {"type": "object"}, "sequence_continuity": {"type": "string", "enum": ["continuous", "gaps"]}, "sequence_gaps": {"type": "array", "items": {"type": "object"}}, "loss": {"type": "boolean"}, "overflow": {"type": "boolean"}, "overflow_count": {"type": "integer", "minimum": 0}, "buffer_high_watermark": {"type": ["integer", "null"], "minimum": 0}, "truncation": {"type": "boolean"}, "corruption": {"type": "boolean"}, "alignment_degradation": {"type": "boolean"}, "mapping_mismatch": {"type": "boolean"}, "observer_loss": {"type": "boolean"}, "affected_intervals": {"type": "array", "items": {"type": "object"}}, "affected_channels": {"type": "array", "items": {"type": "string"}}, "affected_entities": {"type": "array", "items": {"type": "string"}}, "natural_overflow": {"type": "boolean"}, "integrity_status": {"type": "string", "enum": ["complete", "degraded", "invalid"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "record_digest": {"type": "string"}, "prior_cir_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
