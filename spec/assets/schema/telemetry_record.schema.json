{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TelemetryRecord",
  "type": "object",
  "required": [
    "record_version",
    "run_id",
    "dataset_id",
    "platform",
    "export_family",
    "embodiment_mode",
    "input_bytes",
    "sidecar_bytes",
    "sidecar_row_count",
    "sidecar_bytes_scanned",
    "sidecar_validate_seconds",
    "index_build_open_seconds",
    "index_reused",
    "index_rebuilt",
    "closure_seconds",
    "window_read_seconds",
    "package_write_seconds",
    "runtime_seconds",
    "peak_rss_mb",
    "proof_hash",
    "closure_mode",
    "advisor_overhead_seconds"
  ],
  "properties": {
    "record_version": {"type": "string"},
    "run_id": {"type": ["string", "null"]},
    "dataset_id": {"type": ["string", "null"]},
    "platform": {"type": "string"},
    "export_family": {"type": ["string", "null"]},
    "embodiment_mode": {"type": ["string", "null"]},
    "input_bytes": {"type": ["integer", "null"], "minimum": 0},
    "sidecar_bytes": {"type": ["integer", "null"], "minimum": 0},
    "sidecar_row_count": {"type": ["integer", "null"], "minimum": 0},
    "sidecar_bytes_scanned": {"type": ["integer", "null"], "minimum": 0},
    "sidecar_validate_seconds": {"type": ["number", "null"], "minimum": 0},
    "index_build_open_seconds": {"type": ["number", "null"], "minimum": 0},
    "index_reused": {"type": ["boolean", "null"]},
    "index_rebuilt": {"type": ["boolean", "null"]},
    "closure_seconds": {"type": ["number", "null"], "minimum": 0},
    "window_read_seconds": {"type": ["number", "null"], "minimum": 0},
    "package_write_seconds": {"type": ["number", "null"], "minimum": 0},
    "runtime_seconds": {"type": ["number", "null"], "minimum": 0},
    "peak_rss_mb": {"type": ["number", "null"], "minimum": 0},
    "proof_hash": {"type": ["string", "null"]},
    "closure_mode": {"type": ["string", "null"]},
    "advisor_overhead_seconds": {"type": ["number", "null"], "minimum": 0},
    "sidecar_lookup_count": {"type": ["integer", "null"], "minimum": 0},
    "write_mode": {"type": ["string", "null"]},
    "stage_timings": {"type": "object"},
    "rss_snapshots": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
