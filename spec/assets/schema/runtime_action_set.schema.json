{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeActionSet",
  "type": "object",
  "required": [
    "action_set_version",
    "generated_at",
    "proposed_actions",
    "abstained",
    "abstain_reason"
  ],
  "properties": {
    "action_set_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "proposed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "action_kind",
          "required_artifacts",
          "expected_benefit",
          "risk_level",
          "proof_scope_impact",
          "fallback_action"
        ],
        "properties": {
          "action_id": {"type": "string"},
          "action_kind": {"type": "string"},
          "required_artifacts": {
            "type": "array",
            "items": {"type": "string"}
          },
          "expected_benefit": {
            "type": "object",
            "properties": {
              "runtime_seconds_delta": {"type": ["number", "null"]},
              "peak_rss_mb_delta": {"type": ["number", "null"]},
              "notes": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": true
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "proof_scope_impact": {"type": "string"},
          "fallback_action": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "abstained": {"type": "boolean"},
    "abstain_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
